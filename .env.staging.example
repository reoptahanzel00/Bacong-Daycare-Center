# Staging Supabase project — used ONLY by the authenticated E2E suite.
# Copy to .env.staging.local (gitignored) and fill in from the staging
# project's Settings -> API page. Never point these at production: the seeded
# accounts below have a known password.

NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# The same values, under the names the Playwright config looks for.
E2E_SUPABASE_URL=https://<staging-ref>.supabase.co
E2E_SUPABASE_ANON_KEY=<staging-anon-key>
E2E_SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# Password given to every seeded test account. Pick something strong anyway.
E2E_PASSWORD=<pick-a-strong-password>
