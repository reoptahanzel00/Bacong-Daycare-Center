# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
dist/
build/

# Environment variables — NEVER commit these.
# Deny by default and allow the one template back, so a new .env.<something>
# is ignored the moment it is created rather than when someone remembers to
# add it here. .env.staging.local holds a service-role key.
.env*
!.env.example

# TypeScript build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
/coverage

# Vercel
.vercel

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Marketplace agent skill content (restored from skills-lock.json)
.agents/
