# Supabase Configuration (Required)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-only — NEVER expose to client)
# Required for admin operations: user provisioning, audit log writes, password resets
# ⚠️ Never commit this key to source control — it bypasses all Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMS Gateway (Optional — for automated parent notifications)
# Sign up at: https://semaphore.co (Philippine SMS gateway)
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=BacongDaycare

# Email dispatch for notifications (Optional — enables email alerts)
# Sign up at: https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Bacong Daycare <onboarding@resend.dev>

# Rate limiting store (Required for production - see DEPLOYMENT.md)
# Without these the sign-in rate limit is per-instance only, which is not a
# real limit on serverless. Provision with: npx vercel integration add upstash
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DAYCARE_NAME=Barangay Bacong Daycare Center
NEXT_PUBLIC_SCHOOL_YEAR=2026-2027
NEXT_PUBLIC_BARANGAY=Bacong
NEXT_PUBLIC_MUNICIPALITY=Negros Oriental
